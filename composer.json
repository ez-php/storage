{
    "name": "ez-php/storage",
    "version": "1.2.0",
    "description": "File storage abstraction for the ez-php framework — local filesystem and S3-compatible drivers",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Uretschnig",
            "email": "andreas.uretschnig@gmail.com"
        }
    ],
    "keywords": [
        "storage",
        "s3",
        "filesystem",
        "php",
        "framework",
        "ez-php"
    ],
    "homepage": "https://github.com/ez-php/storage",
    "support": {
        "issues": "https://github.com/ez-php/storage/issues",
        "source": "https://github.com/ez-php/storage"
    },
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ez-php/contracts": "^1.1",
        "ez-php/http": "^1.1"
    },
    "require-dev": {
        "ez-php/docker": "^1.1",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "EzPhp\\Storage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "full": "composer analyse && composer cs && composer test"
    }
}
